rectangle "AntFarm\n<size:16>[Software System]</size>" <<Boundary-QW50RmFybQ==>> {
  component "==World\n<size:16>[Component: Module]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as AntFarm.AntFarm.World
  component "==Colony\n<size:16>[Component: Module]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as AntFarm.AntFarm.Colony
  component "==Food\n<size:16>[Component: Module]</size>" <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as AntFarm.AntFarm.Food
